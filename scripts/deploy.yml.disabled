name: Deploy to GitHub Pages

on:
  push:
    branches: [main]
  workflow_dispatch:

permissions:
  contents: read
  pages: write
  id-token: write

concurrency:
  group: pages
  cancel-in-progress: true

jobs:
  build:
    runs-on: ubuntu-latest
    steps:
      - name: Checkout
        uses: actions/checkout@v4

      - name: Setup Bun
        uses: oven-sh/setup-bun@v2

      - name: Install dependencies
        run: bun install --frozen-lockfile

      - name: Compute base path
        run: |
          R="${GITHUB_REPOSITORY#*/}"
          if [[ "$R" == *.github.io ]]; then
            BASE_PATH=""
          else
            BASE_PATH="/$R"
          fi
          echo "BASE_PATH=$BASE_PATH" >> "$GITHUB_ENV"
          echo "Repo: $GITHUB_REPOSITORY → Base path: '$BASE_PATH'"

      - name: Build static export
        run: bun run build:static
        env:
          NEXT_PUBLIC_BASE_PATH: ${{ env.BASE_PATH }}

      - name: Disable Jekyll
        # Next.js 16: output=export + custom distDir হলে এক্সপোর্ট সাইট distDir (.next-static)-এ লেখে —
        # স্ট্যান্ডার্ড out/ কনভেনশনে আনা হচ্ছে
        run: rm -rf out && mv .next-static out && touch out/.nojekyll

      - name: Upload Pages artifact
        uses: actions/upload-pages-artifact@v3
        with:
          path: out

  deploy:
    needs: build
    runs-on: ubuntu-latest
    environment:
      name: github-pages
      url: ${{ steps.deployment.outputs.page_url }}
    steps:
      - name: Deploy to GitHub Pages
        id: deployment
        uses: actions/deploy-pages@v4
